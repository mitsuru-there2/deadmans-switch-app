# No demo fallback in release builds. Demo requires both __DEV__ and this value.
EXPO_PUBLIC_APP_MODE=demo
# Native API mode only. iOS simulator: localhost; Android emulator: 10.0.2.2.
# EXPO_PUBLIC_APP_MODE=api
# EXPO_PUBLIC_API_URL=http://localhost:8787
# No secrets belong in EXPO_PUBLIC_* variables.
# Existing EAS project only; registration stays unavailable when unset.
# EXPO_PUBLIC_EAS_PROJECT_ID=
# Purchase/restore stays disabled without all of these existing settings.
# Set only after store products and API product map match. Public SDK keys only.
# EXPO_PUBLIC_BILLING_ENABLED=1
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...
